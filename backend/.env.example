# Copia a backend/.env (no versionado). Todas obligatorias salvo las marcadas.
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA@HOST:5432/acuarius
# Origenes del frontend (coma). Con credenciales: el navegador envia cookies y DPoP.
CORS_ORIGINS=http://localhost:3300
# Base de la API de Incubus (resultados y verificacion del codigo de activacion).
INCUBUS_API_URL=http://localhost:8001
# Leo: SSO (BFF /auth/*) y credencial de servicio (audiencias `leo` e `incubus`).
# El secreto solo por entorno; nunca en codigo ni en el repo. La app `acuarius` en
# Leo necesita: rol leo-patient-provisioner (crear pacientes) y acceso al servicio
# `incubus` con el tag incubus.results-delivery.view.
LEO_URL=http://localhost:3100
LEO_API_URL=http://localhost:8100/api/v1
APP_CLIENT_ID=acuarius
APP_CLIENT_SECRET=
# URL publica de ESTE backend (fija el htu de DPoP).
PUBLIC_URL=http://localhost:8200
COOKIE_SECURE=false
# Retorno del SSO registrado en Leo: URL del FRONTEND + su callbackPath.
APP_REDIRECT_URI=http://localhost:3300/leo/callback
# Opcionales: cookies (por defecto acuarius_access / acuarius_refresh / acuarius_oauth).
# ACCESS_COOKIE_NAME=acuarius_access
# REFRESH_COOKIE_NAME=acuarius_refresh
# FLOW_COOKIE_NAME=acuarius_oauth
# Opcionales: DOCS_ENABLED=true (solo desarrollo); limites del alta:
# ACTIVATION_MAX_PER_IP_DOC=5 ACTIVATION_MAX_PER_DOC=15 ACTIVATION_MAX_PER_IP=30
# ACTIVATION_WINDOW_SECONDS=900
