# Copia este archivo a `.env` (no se versiona).

# API de Acuarius. Debe colgar de NUXT_PUBLIC_LEO_API_BASE.
NUXT_PUBLIC_API_BASE=http://localhost:8200/api/v1

# Leo (SSO + permisos), transporte `bff`: el navegador habla solo con el backend de Acuarius.
NUXT_PUBLIC_LEO_TRANSPORT=bff
# Backend de Acuarius, SIN /api/v1 (aquí viven /auth/login, /auth/callback, /auth/me, /auth/logout).
NUXT_PUBLIC_LEO_API_BASE=http://localhost:8200
# = PUBLIC_URL del backend (fija el `htu` de las pruebas DPoP).
NUXT_PUBLIC_LEO_PUBLIC_URL=http://localhost:8200
NUXT_PUBLIC_LEO_APP_SLUG=acuarius
NUXT_PUBLIC_LEO_APP_NAME=Acuarius
# Ruta del FRONTEND que recibe ?code&state (= APP_REDIRECT_URI del backend y redirect_uri en Leo).
NUXT_PUBLIC_LEO_CALLBACK_PATH=/leo/callback
NUXT_PUBLIC_LEO_AUTH_PATH=/auth
# Frontend de Leo (enlace "Mi perfil").
NUXT_PUBLIC_LEO_URL=http://localhost:3100
